# Copy to .env and fill in. Never commit .env.
# Stripe TEST mode only. These are obviously fake placeholders.
STRIPE_SECRET_KEY=sk_test_REPLACE_ME
STRIPE_WEBHOOK_SECRET=whsec_REPLACE_ME
# Filled in by `npm run seed:stripe` (prints them); price lookup keys are stable.
STRIPE_PRICE_PRO_MONTHLY=price_REPLACE_ME
STRIPE_PRICE_PRO_YEARLY=price_REPLACE_ME
STRIPE_PRICE_TEAM_SEAT=price_REPLACE_ME

# Postgres (matches docker-compose.yml)
POSTGRES_USER=pagemint
POSTGRES_PASSWORD=pagemint_local_only
POSTGRES_DB=pagemint
POSTGRES_PORT=5432
DATABASE_URL=postgres://pagemint:pagemint_local_only@localhost:5432/pagemint

# Next.js app (nextjs/)
AUTH_SECRET=REPLACE_ME_with_output_of_openssl_rand_base64_32
APP_URL=http://localhost:3000
# Local demo only: enables email-only sign-in with NO verification (anyone can be anyone, including an admin).
# Deliberately insecure for demonstration. Do not deploy.
DEMO_AUTH=1
# Comma separated; unset = nobody is admin. Only meaningful with a real auth provider.
# ADMIN_EMAILS=you@example.com

# Spring Boot implementation (spring-boot/): HTTP API tokens (HS256, at least 32 bytes)
# JWT_SECRET=REPLACE_ME_with_output_of_openssl_rand_base64_32
